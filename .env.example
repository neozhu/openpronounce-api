# API key (required by default; set REQUIRE_API_KEY=false only on isolated private networks)
OPENPRONOUNCE_API_KEY=change-me

# Remote HTTPS audio URL ingestion (disabled by default)
URL_FETCH_ENABLED=false
ALLOWED_AUDIO_HOSTS=

# Optional overrides (all have production defaults built in):
# REQUIRE_API_KEY=true
# MAX_CONCURRENT_INFERENCES=1
# ENABLE_DOCS=false
# CORS_ALLOW_ORIGINS=
# HF_HOME=/opt/models/huggingface
# HF_HUB_OFFLINE=1
